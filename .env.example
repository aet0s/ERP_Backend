PORT=4000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_erp_2026
SUPER_ADMIN_SECRET=your_super_admin_secret_key_erp_2026

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# Master Database Name (e.g. lamssolarman_erp_master or erp_master)
MASTER_DB_NAME=lamssolarman_erp_master

# Full Database URLs
MASTER_DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/lamssolarman_erp_master
MASTER_DATABASE_ADMIN_URL=mysql://your_db_user:your_db_password@localhost:3306/mysql

# Optional: Prefix for company tenant databases (useful on cPanel/managed hosts that enforce user prefixes)
# Leave empty for standard "erp_company_" prefix
# TENANT_DB_PREFIX=lamssolarman_erp_

# Platform Super Admin Initial Credentials (used by npm run setup:master)
PLATFORM_ADMIN_EMAIL=admin@platform.com
PLATFORM_ADMIN_PASSWORD=YourSecurePassword2026!

# Connection pool ceiling per instance
MAX_ACTIVE_TENANT_POOLS=50
TENANT_DB_POOL_MAX=5
MASTER_DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=300000
